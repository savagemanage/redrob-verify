# Optional secrets — copy to `.env` (never commit `.env`)

# GitHub API (identity / resume generators; unauthenticated works with low rate limits)
GITHUB_TOKEN=

# Optional LLM for resume body text (tools/gen_resumes.py)
OPENAI_API_KEY=
RESUME_LLM_URL=https://api.openai.com/v1/chat/completions

# Forgery backend override (default in config.yaml / compose: forgery_net)
# FORGERY_BACKEND=forgery_net
# FORGERY_BACKEND=trufor
